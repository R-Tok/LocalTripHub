<% content_for(:title, t('.title')) %>

    <div class="col-lg-8 offset-lg-2">
      <h1><%= t('.title') %></h1>
      <div class="text-center my-4">
        <%= link_to t('.select_newly'), "#new_spot", class:"btn btn-warning" %>
        <%= link_to t('.select_created'), "#registered_spots", class:"btn btn-primary" %>
      </div>
    
      <div class="mb-3 bg-warning-subtle">
        <h2 id="new_spot">A. スポットを新規作成する</h2>
        <%= link_to t('.link_to_spot_create'), new_spot_path, data: { turbo: false }, class: "btn btn-primary text-center d-grid gap-2 col-6 mx-auto" %>
      </div>

      <%= render "created_spot_map" %>

    </div>

