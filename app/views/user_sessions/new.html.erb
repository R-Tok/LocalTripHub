<% content_for(:title, t('.title')) %>
<div class="col-md-10 col-lg-8 mx-auto">
  <h1><%= t('.title') %></h1>
  <%= form_with url: login_path do |f| %>

    <div class="mb-3">
      <%= f.label :email %>
      <%= f.email_field :email, class: "form-control", required: true %>
    </div>

    <div class="mb-3">
      <%= f.label :password %>
      <%= f.password_field :password, class: "form-control", required: true %>
    </div>

    <div class="d-grid gap-2 col-8 mx-auto mb-3">
      <%= f.submit t('.login'), class: "btn btn-success", data: { turbo: false } %>
    </div>
  <% end %>
  <br>

  <%= link_to auth_at_provider_path(provider: :google), class: 'google btn btn-outline-secondary d-grid gap-2 col-8 mx-auto my-3 d-flex align-items-center justify-content-center' do %>
    <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" class="me-2" style="height: 20px;">
    Googleでログイン
  <% end %>

  <%= link_to auth_at_provider_path(provider: :twitter), class: 'twitter btn btn-dark d-grid gap-2 col-8 mx-auto my-3' do %>
    <div><i class="bi bi-twitter-x"></i> Xアカウントでログイン</div>
  <% end %>
  <br>

  <div class='text-center'>
    <%= link_to t('.to_register_page'), new_user_path %>
    <br>
    <%= link_to t('.password_forget'), new_password_reset_path %>
  </div>
  <br>
</div>
