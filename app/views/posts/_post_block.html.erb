
  <% @posts.each do |post| %>
    
      <div class="post-preview d-flex border mb-3" style="height: 205px;" >
        <!-- 画像表示エリア -->
        <div class="image-area d-flex overflow-auto" style="background-color: #f0f0f0; width: 50%; height: 100%; white-space: nowrap;">
          <% post.images&.each do |image| %>
            <% if image.image_url.present? %>
              <div class="image-box mr-2" style="display: inline-block; border: 2px solid #f0f0f0;">
                <%= image_tag image.image_url.url, height: "186px", class: "mr-1" %>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- テキスト表示エリア -->
        <div class="d-flex flex-column mb-3" style="width: 50%; height: 100%;">
          <div class="d-flex justify-content-between p-2">
            <%= link_to (current_user == post.user ? profile_path : user_path(post.user)), data: { turbo: false }, class: 'nav-link' do %>
              <div class="text-truncate">
                <%= image_tag post.user.avatar.url, class: 'rounded-circle', size: '30x30' %>
                <span class="ms-2 text-primary text-decoration-underline"><%= post.user.nickname %></span>
              </div>
            <% end %>
            <div>
              <% if current_user&.own?(post) %>
                <%= link_to t('helpers.submit.edit'), edit_spot_post_path(post.spot, post), data: { turbo: false }, class:"btn btn-sm btn-primary" %>
                <%= link_to t('helpers.submit.delete'), spot_post_path(post.spot, post), data: { turbo: false }, data: { turbo_confirm: t('posts.delete_confirm'), turbo_method: :delete }, class:"btn btn-sm btn-danger" %>
              <% end %>
            <%= l post.created_at %>
            </div>
          </div>

          <div class="mt-2 text-truncate p-2" >
            <%= post.content %>
          </div>
          
          <div class="mt-2 text-truncate p-2">
            <%= post.access_info %>
          </div>
          <div class="d-grid gap-2 col-9 mx-auto">
            <%= link_to t('posts.index.link_to_detail'), spot_post_path(post.spot, post), data: { turbo: false }, class:"btn btn-outline-primary p-2" %>
          </div>
        </div>
      </div>
    
  <% end %>
