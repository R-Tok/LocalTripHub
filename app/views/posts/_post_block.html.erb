
  <% @posts.each do |post| %>
    
      <div class="post-preview d-flex border mb-3" style="height: 205px;" >
        <!-- 画像表示エリア -->
        <div class="image-area d-flex overflow-auto" style="background-color: #f0f0f0; width: 50%; height: 100%; white-space: nowrap;">
          <% post.images&.each do |image| %>
            <% if image.image_url.present? %>
              <div class="image-box mr-2" style="display: inline-block; border: 2px solid #f0f0f0;">
                <%= image_tag image.image_url.url, height: "186px", class: "mr-1" %>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- テキスト表示エリア -->
        <div class="d-flex flex-column mb-3" style="width: 50%; height: 100%;">
          <div class="d-flex justify-content-between p-2">
            <div class="text-truncate">
              <%= link_to (current_user == post.user ? profile_path : user_path(post.user)), data: { turbo: false }, class: 'nav-link d-flex align-items-center flex-grow-1 text-dark link-underline-dark link-underline-opacity-0 link-underline-opacity-75-hover' do %>
              
                <%= image_tag post.user.avatar.url, class: 'rounded-circle flex-shrink-0', size: '30x30' %>
                <div class="ms-2 d-inline-block text-truncate col-8 d-none d-lg-inline">
                  <%= post.user.nickname %>
                </div>
              <% end %>
            </div>
            
            <div class="d-flex align-items-center">
              <%= l post.created_at, format: :date %>
              <% if logged_in? %>
                <div class="dropdown dropdown-slide nav-item">
                  <button class='btn btn-sm btn-outline-dark' type="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" id='post-menu' >
                    …
                  </button>
                  <ul class="dropdown-menu text-center">
                    <li>
                      <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addToListModal-<%= post.id %>">リストへ追加</button>
                    </li>
                    <% if current_user&.own?(post) %>
                      <li><%= link_to t('helpers.submit.edit'), edit_spot_post_path(post.spot, post), data: { turbo: false }, class:"btn btn-sm btn-primary" %></li>
                      <li><%= link_to t('helpers.submit.delete'), spot_post_path(post.spot, post), data: { turbo: false }, data: { turbo_confirm: t('posts.delete_confirm'), turbo_method: :delete }, class:"btn btn-sm btn-danger" %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>

          <!-- リスト選択のモーダル -->
          <div id="addToListModal-<%= post.id %>" class="modal fade" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">投稿をリストへ追加</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  <% if logged_in? %>
                    <% if current_user.lists.present? %>
                      <%= form_with url: bookmarks_path, method: :post, remote: true do |f| %>
                        <%= f.hidden_field :post_id, value: post.id %> <!-- 追加対象のポストID -->

                        <%= f.collection_check_boxes :list_ids, List.where(user_id: current_user&.id), :id, :name, checked: post.list_ids do |b| %>
                          <div class="d-flex">
                            <div><%= b.check_box %></div>
                            <div><%= b.text %></div>
                          </div>
                        <% end %>

                        <%= f.submit "追加する", class: "btn btn-success d-grid mx-auto w-50 my-3" %>
                      <% end %>
                    <% else %>
                      作成済みリストがありません
                      <%= link_to "リスト作成へ移動", user_lists_path(current_user.id), class: "btn btn-success d-grid mx-auto w-50 my-3" %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div class="text-truncate p-2" >
            <%= post.content %>
          </div>
          
          <div class="text-truncate p-2">
            <%= post.access_info %>
          </div>
          <div class="d-grid gap-2 col-9 mx-auto my-2 mt-auto">
            <%= link_to t('posts.index.link_to_detail'), spot_post_path(post.spot, post), data: { turbo: false }, class:"btn btn-outline-success p-2" %>
          </div>
        </div>
      </div>
    
  <% end %>
