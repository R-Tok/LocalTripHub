<% content_for(:title, t('.title')) %>


  <h1><%= t('.title') %></h1>
  <div class="text-center my-4">
    <%= link_to t('.select_newly'), "#new_spot", class: "btn btn-outline-success" %>
    <%= link_to t('.select_created'), "#registered_spots", class: "btn btn-outline-primary", id: "new_spot" %>
  </div>

  <div class="my-3 bg-success-subtle">
    <h2 class="my-2">A. スポットを新規作成する</h2>
    <%= link_to t('.link_to_spot_create'), new_spot_path, data: { turbo: false }, class: "btn btn-success text-center d-grid gap-2 col-8 mx-auto my-2", id:"registered_spots"%>
  </div>

  <div class="bg-info-subtle my-3">
    <h2 class="my-2">B. 登録済みスポットから選ぶ</h2>
    <p class="fw-semibold">【Tips】<br>既に投稿が付いているスポットに追加で投稿できますが、投稿状況マップの色塗りには影響しません。</p>
    <p>地図上でピンを選択し、「このスポットについて投稿する」ボタンを押してください</p>

    <%= render "created_spot_map" %>

  </div>

