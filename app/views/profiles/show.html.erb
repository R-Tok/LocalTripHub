<% content_for(:title, t('.title')) %>

<h1><%= t('.title') %></h1>
<br>

<!-- 登録情報 -->
<h2>登録情報</h2>
<div class="col-lg-8 offset-lg-2">
  <div class="d-flex border-bottom border-secondary">
    <div class="p-2 flex-fill">メールアドレス</div>
    <div class="p-2 flex-fill"><%= @user.email %></div>
  </div>

  <div class="d-flex border-bottom border-secondary mb-3">
    <div class="p-2 flex-fill">パスワード</div>
    <div class="p-2 flex-fill"><%= '*' * @user.password_length %></div>
  </div>
  <br>
</div>

<!-- プロフィール情報 -->
<div class="d-flex justify-content-between">
  <h2>プロフィール<h2>
  <div>
    <%= link_to "編集", edit_profile_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="d-flex justify-content-evenly column-gap-3 mb-3">
  <div>
    <%= image_tag @user.avatar.url, class: 'rounded-circle', size: '100x100' %>
  </div>
  <div class="flex-fill">
    <div class="border border-secondary text-break p-2 my-3">
            ニックネーム： <%= @user.nickname %>
    </div>
    <div class="border border-secondary p-2">
            自己紹介コメント： <br><%= simple_format(@user.introduction) %>
    </div>
  </div>        
</div>
      
<!-- 自分の投稿一覧 -->
<h2>投稿一覧</h2>
<% if @posts.present? %>
  <%= render "posts/post_block" %>
  <%= paginate @posts, theme: "bootstrap-5" %>
<% else %>
  <div class="text-center mb-3">投稿はありません</div>
<% end %>

<h2>退会する</h2>
<div>
<%= link_to "退会処理へ", unsubscribe_profile_path, class: "btn btn-outline-danger my-3" %>
</div>