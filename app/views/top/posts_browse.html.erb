<% content_for(:title, t('.title')) %>

<h1><%= t('.title') %></h1>

<h2 class="mt-3">
  <span class="rounded-pill mx-2 px-3" style="background-color: #D3EEA7;"><%= t('.from_spot') %>
</h2>
<%= render "spots/created_spot_map" %>

<h2 class="my-3">
  <span class="rounded-pill mx-2 px-3" style="background-color: #D3EEA7;"><%= t('.latest_post') %>
</h2>
<%= search_form_for @q, url: posts_browse_path do |f| %>
  <div class="input-group mb-3">
	  <%= f.search_field :content_or_access_info_or_spot_name_or_spot_prefecture_name_or_spot_municipality_name_cont,
      class: 'form-control', placeholder: t('.search_word') %>
    <div class="input-group-append">
      <%= f.submit class: "btn btn-outline-primary" %>
    </div>
  </div>
<% end %>
<%= render "posts/post_block" %>
<%= paginate @posts, theme: "bootstrap-5" %>