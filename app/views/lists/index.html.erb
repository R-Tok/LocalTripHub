<% content_for(:title, t('.title')) %>

<h1><%= t('.title') %></h1>
<!-- リスト作成ボタン -->
<% if current_user.id == @user.id %>
  <button id="new-list-btn" class="btn btn-success my-3 w-50 d-grid mx-auto" data-bs-toggle="modal" data-bs-target="#list-modal">リストの新規作成</button>
<% end %>

<!-- モーダル用の領域 -->
<div id="list-modal" class="modal fade" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">新しいリストを作成</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= render "list_form" %>
      </div>
    </div>
  </div>
</div>

<div>
  <div class="container-fluid" id="list-container">
    <div class="row">
      <% if @lists.present? && @lists.any?(&:persisted?) %>
        <% @lists.select(&:persisted?).each do |list| %>
          <div class="d-flex align-items-center border border-secondary shadow col-sm-5 mx-auto mx-1 my-3">
            <i class="bi bi-folder2"></i>
            <%= link_to user_list_path(list.user, list), class: "link-underline-dark link-underline-opacity-0 link-underline-opacity-75-hover w-100" do %>
              <h3 class="text-truncate col-10 mx-3 my-2 text-dark"><%= list.name %></h3>
              <h6 class="text-truncate col-10 mx-3 text-secondary">
                <%= list.caption.present? ? list.caption : "-" %>
              </h6>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center my-3">作成されたリストはありません</div>
      <% end %>
    </div>
  </div>  
</div>
