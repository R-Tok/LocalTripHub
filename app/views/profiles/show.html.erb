<% content_for(:title, t('.title')) %>

<h1>マイページ</h1>
<br>

<!-- 登録情報 -->
<h2>登録情報</h2>
<div class="col-lg-8 offset-lg-2">
  <div class="d-flex border-bottom border-secondary">
    <div class="p-2 flex-fill">SNSログイン</div>
    <div class="p-2 flex-fill">
      <% if @user.authentications.find_by(provider: "twitter") %>
        <i class="bi bi-twitter-x"></i> Xアカウントでログイン済
      <% elsif @user.authentications.find_by(provider: "google") %>
        <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google logo" class="me-2" style="height: 20px;">Googleでログイン済
      <% else %>
        未登録
      <% end %>
    </div>
  </div>

  <div class="d-flex border-bottom border-secondary">
    <div class="p-2 flex-fill">メールアドレス</div>
    <div class="p-2 flex-fill"><%= @user.email %></div>
  </div>

  <div class="d-flex border-bottom border-secondary mb-3 align-items-center">
    <div class="p-2 flex-fill">パスワード</div>
    <div class="p-2 flex-fill">
      <% if @user.password_length.present? %>
        <%= '*' * @user.password_length %>
      <% end %>
    </div>
    <div>
      <%= link_to "変更", new_password_reset_path, class: "btn btn-sm btn-secondary" %>
    </div>
  </div>
  <br>
</div>

<!-- プロフィール情報 -->
<div class="d-flex justify-content-between align-items-center">
  <h2>プロフィール<h2>
  <div>
    <%= link_to "編集", edit_profile_path, class: "btn btn-sm btn-secondary" %>
  </div>
</div>

<div class="d-flex justify-content-evenly column-gap-3 mb-3">
  <div>
    <%= image_tag @user.avatar.url, class: 'rounded-circle', size: '100x100' %>
  </div>
  <div class="flex-fill">
    <div class="border border-secondary text-break p-2 my-3">
      ニックネーム： <%= @user.nickname %>
    </div>
    <div class="border border-secondary p-2">
      自己紹介コメント： <br><%= simple_format(@user.introduction) %>
    </div>
  </div>        
</div>

<h2>退会する</h2>
<div>
<%= link_to "退会処理へ", unsubscribe_profile_path, class: "btn btn-outline-danger my-3" %>
</div>