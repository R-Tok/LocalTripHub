<!DOCTYPE html>
<html>
  <head>
    <title><%= page_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= favicon_link_tag("Favicon.png") %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" defer integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>

    <!-- vue導入 -->
    <%= javascript_pack_tag 'hello_vue' %>
    <%= stylesheet_pack_tag 'hello_vue' %>

    <!-- タイトルのフォント -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,400&display=swap" rel="stylesheet">

    <%= display_meta_tags(default_meta_tags) %>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-TY4XYTW8BS"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-TY4XYTW8BS');
    </script>
  </head>

  <body>
      <% if logged_in? %>
        <%= render 'shared/header' %>
      <% else%>
        <%= render 'shared/before_login_header' %>
      <% end%>
      <%= render 'shared/flash_message' %>

      <% if current_page?(root_path) %>
        <%= yield %>
      <% else %>
        <div class="container">
          <div class="row">
            <%= yield %>
          </div>
        </div>
      <% end %>
    
      <%= render 'shared/footer' %>
  </body>
</html>
