  <div id='spot_create_map' class="mx-auto my-3"></div>
  <style>
    #spot_create_map { height: 500px; width: 90%;}
  </style>

  <script>
  const prefectureMap = {
    <% @prefectures&.each do |prefecture| %>
      "<%= prefecture.name %>": <%= prefecture.id %>,
    <% end %>
  };

  const municipalityMap = {
    <% @municipalities&.each do |municipality| %>
      "<%= municipality.prefecture.name %><%= municipality.name %>": <%= municipality.id %>,
    <% end %>
  };

    function initMap(){
      geocoder = new google.maps.Geocoder()

      map = new google.maps.Map(document.getElementById('spot_create_map'), {  // 初期表示の位置とピン
        center: {lat: 35.6812, lng: 139.7671},
        zoom: 10,
      });
      marker = new google.maps.Marker({
        position:  {lat: 35.6812, lng: 139.7671},
        map: map
      });

      // ①地図上のクリックにより座標を指定するルート
      map.addListener("click", function(event) {

        placeMarker(event.latLng);
        setLatLng(event.latLng);
        setPrefAndCity(event.latLng);
      });

      // ②検索ボックスのオートコンプリート候補からスポットを選択するルート
      const input = document.getElementById("address");
      const option = {
        componentRestrictions: { country: 'JP' }
      };
      const autocomplete = new google.maps.places.Autocomplete(input, option);  // オートコンプリート適用

      autocomplete.addListener("place_changed", () => {
        const place = autocomplete.getPlace();
    
        if (!place.geometry || !place.geometry.location) {
          alert("場所が見つかりませんでした");
          return;
        }
        map.setCenter(place.geometry.location);

        placeMarker(place.geometry.location);
        setLatLng(place.geometry.location);
        setPrefAndCity(place.geometry.location);
      });
    }

    // ③検索ボックスの「検索」をクリックして座標を指定するルート
    function codeAddress(){
      let inputAddress = document.getElementById('address').value;

      geocoder.geocode( { 'address': inputAddress}, function(results, status) {
        if (status == 'OK') {
          map.setCenter(results[0].geometry.location);

          placeMarker(results[0].geometry.location);
          setLatLng(results[0].geometry.location);
          setPrefAndCity(results[0].geometry.location);
        } else {
          alert("場所が見つかりませんでした");
          return;          
        }
      });   
    }

    // 【共通】マーカーを新規に設定するメソッド
    function placeMarker(location) {
      if(marker) {
        marker.setMap(null);  //既存のピンを削除
      }
      marker = new google.maps.Marker({
        position: location,
        map: map
      });
    }

    // 【共通】マーカー座標の緯度経度をフォームに自動入力するメソッド
    function setLatLng(location) {
      document.getElementById('spot_latitude').value = location.lat().toFixed(6);
      document.getElementById('spot_longitude').value = location.lng().toFixed(6);
    }

    // 【共通】マーカーの座標から県と市町村を逆引きして自動選択するメソッド
    function setPrefAndCity(latLng) {
      geocoder.geocode({ "location": latLng }, function(results, status) {
        if (status == "OK" && results[0]) {
          // Geocode結果から市町村を取得
          let addressComponents = results[0].address_components;
          let prefecture = '';
          let municipality = '';
          let administrativeAreaLevel2 = '';  // 郡名
          let locality = '';  // 市町村名
          let sublocalityLevel1 = '';  // 政令指定都市の区名

          // 市町村の情報を抽出
          addressComponents.forEach(function(component) {
            if (component.types.includes('administrative_area_level_1')) {
              prefecture = component.long_name;  //  都道府県名
            }
            if (component.types.includes('administrative_area_level_2')) {
              administrativeAreaLevel2 = component.long_name;  // 郡名
            }
            if (component.types.includes('locality')) {
              locality = component.long_name;  // 市町村名　23区含む
            }
            if (component.types.includes('sublocality_level_1')) {
              sublocalityLevel1 = component.long_name;  // 政令指定都市の区名
            }
          });

          if (administrativeAreaLevel2) {
            // 郡名 + 市町村名 の場合
            municipality = administrativeAreaLevel2 + locality;
          } else if (sublocalityLevel1) {
            // 市町村名 + 区名 の場合
            municipality = locality + sublocalityLevel1;
          } else {
            // それ以外の場合は普通に市町村名だけ
            municipality = locality;
          }

          display.textContent = prefecture + municipality  //市町村の取得結果をテキストでページに表示
          
          // フォームに自動入力
          const prefectureId = prefectureMap[prefecture]; // 県名から県IDを取得
          if (prefectureId) {
            document.getElementById('spot_prefecture_id').value = prefectureId;  // 都道府県を選択

            const url = `/municipalities?prefecture_id=${prefectureId}`;
            fetch(url, {
              headers: { Accept: "text/vnd.turbo-stream.html" }
            })
            .then((response) => response.text())
            .then((html) => {
              // 市町村リストを更新
              const municipalityFrame = document.querySelector("#municipality_select_frame");
              if (municipalityFrame) {
                municipalityFrame.innerHTML = html;

                // 市町村IDを取得し、自動的に選択
                setTimeout(() => {
                  const combinedKey = prefecture + municipality;
                  const municipalityId = municipalityMap[combinedKey];
                  if (municipalityId) {
                    document.getElementById('spot_municipality_id').value = municipalityId;  // 市町村を選択
                  } else {
                    alert('対応する市区町村が見つかりませんでした');
                  }
                }, 100); // 100ms 待機してから市町村を選択
              } else {
                console.error("municipality_select_frame の要素が見つかりません");
              }
            })
            .catch((error) => {
              console.error("エラーが発生しました:", error);
            });

          } else {
            alert('対応する都道府県が見つかりませんでした');
          }
        } else {
          alert('市町村情報を取得できませんでした');
        }
      });
    }

  </script>
  <script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&libraries=places&callback=initMap" async defer></script>
