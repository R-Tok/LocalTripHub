<% content_for(:title, t('.title')) %>
  
  <%= render "spots/spot_block" %>

  <div class="d-flex flex-column flex-md-row justify-content-between p-2">
    <div>
      <%= link_to (current_user == @post.user ? profile_path : user_path(@post.user)), class: 'nav-link d-flex align-items-center flex-grow-1' do %>
        <%= image_tag @post.user.avatar.url, class: 'rounded-circle flex-shrink-0', size: '30x30' %>
        <div class="ms-2 d-inline-block text-truncate col-8" >
          <%= @post.user.nickname %>
        </div>
      <% end %>
    </div>

    <div class="d-flex flex-wrap align-items-center ms-auto">
      <%= l @post.created_at %>
      <% if current_user&.own?(@post) %>
        <%= link_to t('helpers.submit.edit'), edit_spot_post_path(@post.spot, @post), class:"btn btn-sm btn-primary" %>
        <%= link_to t('helpers.submit.delete'), spot_post_path(@post.spot, @post), data: { turbo_confirm: t('posts.delete_confirm'), turbo_method: :delete }, class:"btn btn-sm btn-danger" %>
      <% end %>
      <% if logged_in? %>
        <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addToListModal-<%= @post.id %>">
          <i class="bi bi-bookmark-heart" style="font-size: 18px;"></i>
        </button>
      <% end %>
    </div>
  </div>

  <%= render "posts/bookmark_modal", post: @post %>

  <div class="d-flex flex-wrap gap-2">
    <% @post.images&.each do |image| %>
      <% if image.image_url.present? %>
        <div class="p-0">
          <%= image_tag image.image_url.url, height: "240px", class: "mr-1" %>
        </div>
      <% end%>
    <% end%>
  </div>

  <h5 class="fw-semibold"><%= Post.human_attribute_name("content") %></h5>
  <div class="border border-2 p-2 mb-3">
    <%= simple_format(@post.content) %>
  </div>
  <br>
  <h5 class="fw-semibold"><%= Post.human_attribute_name("access_info") %></h5>
  <div class="border border-2 p-2 mb-3">
    <%= simple_format(@post.access_info) %>
  </div>
  <br>
