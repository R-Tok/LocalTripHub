<% content_for(:title, t('.title')) %>
<div class='top-wrapper'>
  <div class='top-inner-text'>
    

    <div class="d-flex flex-column flex-sm-row justify-content-center">
      <!-- トップ画像表示エリア-->
      <div id="carouselExampleFade" class="carousel slide carousel-fade  flex-fill col-12 col-sm-6" data-bs-ride="carousel" data-bs-pause="false"">

        <div class="carousel-inner"">
          <% (1..5).each do |i| %>
            <div class="carousel-item <%= 'active' if i == 1 %>">
              <%= image_tag "top_image_#{i}.webp", class: "d-block carousel-img" %>
            </div>
          <% end %>
        </div>  
      </div>

      <!-- トップ キャッチコピーエリア-->
      <div class="d-flex bg-success-subtle bg-gradient text-center align-items-center flex-fill flex-grow-1">
        <div>
        <h4 class="my-3 fst-italic">あなただけの気ままなローカルツーリズムを計画してみませんか？</h4>
          普段と違う町・駅・通り…何気ない場所だって、興味を持って調べた時点であなただけの旅が始まる。
          全国に1,892もある市区町村で日々営まれている生活へと目を向けて、まだ知らない街の景色と魅力を自由に発見しよう。
          <br>
          <div class="my-3" id="modalDescription">
            
          </div>
        </div>
      </div>
    </div>

    <!-- 色塗りマップ-->
    <h2 id="posted_area_map" style="padding-top: 70px; margin-top: -60px;">
      <span class="rounded-pill mx-2 px-3" style="background-color: #D3EEA7;"><%= t('.postmap_title') %></span>
    </h2>
    <p class="mx-3">1つ以上の投稿がされた「スポット数」に応じて、地図が濃く塗られます。投稿を伴わない「スポット登録」だけでは色塗りに反映されません。</p>
    <div class="d-lg-flex justify-content-evenly mx-3">
      
        <%= render "colored_prefmap" %>
      
        <%= render "colored_citymap" %>
      
    </div>

    <!-- 最新の投稿3件-->
    <h2 class="my-3">
      <span class="rounded-pill mx-2 px-3" style="background-color: #D3EEA7;"><%= t('.latest_post') %></span>
    </h2>
    <div class="container">
      <div class="row">
        <%= render "posts/post_block" %>
      </div>
    </div>
    <div class="d-grid gap-2 col-8 mx-auto mb-3">
      <%= link_to t('.link_to_post_browse'), posts_browse_path, data: { turbo: false }, class: "btn btn-success" %>
    </div>

  </div>
  <br>
</div>

<style>
  @media (max-width: 575px) {
    .carousel {
      height: auto !important;
    }
    .carousel-inner {
      height: auto !important;
    }
    .carousel-img {
      width: 100% !important;
      height: auto !important;
    }
  }
</style>