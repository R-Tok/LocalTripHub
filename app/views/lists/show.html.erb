<% content_for(:title, t('.title')) %>

<h1><%= t('.title') %></h1>
<div class="d-flex justify-content-between align-items-center my-3">
  <h3><%= @list.name %></h3>

  <div class="col-2">
    <% if current_user&.own?(@list) %>
      <button id="edit-list-btn" class="btn btn-sm btn-primary my-3" data-bs-toggle="modal" data-bs-target="#list-modal">編集</button>
    <% end %>
  </div>
</div>
<div class="fw-bolder mb-3">
  <%= @list&.caption %>
</div>

<!-- モーダル用の領域 -->
<div id="list-modal" class="modal fade" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">リストを編集</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= render "list_form" %>
        <%= link_to "リストを削除", user_list_path(@list.user, @list), data: { turbo: false }, data: { turbo_confirm: t('lists.delete_confirm'), turbo_method: :delete }, class:"btn btn-sm btn-outline-danger d-grid mx-auto w-25 my-2" %>
      </div>
    </div>
  </div>
</div>

<% if @posts.present? %>
  <div>
    <%= render "posts/post_block" %>
    <%= paginate @posts, theme: "bootstrap-5" %>
  </div>
<% else %>
  <div class="text-center my-3">保存された投稿はありません</div>
<% end %>