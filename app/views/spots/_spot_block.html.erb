<div class= "bg-body-secondary my-3">
  <h3 class="my-2">
    <%= link_to @spot.name, spot_posts_path(@spot), class:"fw-bold text-dark" %>
  </h3>
  <p>
    <i class="bi bi-pin-angle-fill"></i> 
    <%= @spot.prefecture.name %> 
    <%= @spot.municipality.name %>
  </p>
  <p>
    <%= Spot.human_attribute_name("latitude") %>: <%= @spot.latitude %>
    <%= Spot.human_attribute_name("longitude") %>: <%= @spot.longitude %>
    <%= link_to "https://www.google.com/maps/search/?api=1&query=#{@spot.latitude}%2C+#{@spot.longitude}", class: "btn btn-sm btn-secondary", target: :_blank, rel: "noopener noreferrer" do %>
      <i class="bi bi-google"></i>
      マップで開く
    <% end %>
  </p>
  <p>
    <%= t('activerecord.models.category') %>: 
    <% @spot.categories&.each do |category| %>
      <span class="badge bg-success text-wrap"><%= category.name %></span>
    <% end %>
  </p>
</div>