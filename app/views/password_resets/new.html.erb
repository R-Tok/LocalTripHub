<% content_for(:title, t('.title'))%>
<div class="container">
  <div class="row">
    <div class="col-md-10 col-lg-8 mx-auto">
      <h1><%= t('.title')%></h1>
      <p>パスワード再設定用のメールを送信します。</p>
      <p>受信できるメールアドレスを入力してください。</p>
      <%= form_with url: password_resets_path do |f| %>
        <div class="form-group">
          <%= f.email_field :email, class:"form-control" %>
        </div>
        <br>
        <div class="text-center">
          <%= f.submit t('.submit'), class:"btn btn-success d-grid gap-2 col-8 mx-auto mb-3" %>
        </div>
      <%end%>
    </div>
  </div>
</div>