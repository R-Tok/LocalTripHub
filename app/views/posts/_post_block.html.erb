
  <% @posts.each do |post| %>
    
      <div class="post-preview d-flex border mb-3" style="height: 205px;" >
        <!-- 画像表示エリア -->
        <div class="image-area d-flex overflow-auto" style="background-color: #f0f0f0; width: 50%; height: 100%; white-space: nowrap;">
          <% post.images&.each do |image| %>
            <% if image.image_url.present? %>
              <div class="image-box mr-2" style="display: inline-block; border: 2px solid #f0f0f0;">
                <%= image_tag image.image_url.url, height: "186px", class: "mr-1" %>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- テキスト表示エリア -->
        <div class="d-flex flex-column mb-3" style="width: 50%; height: 100%;">
          <div class="d-flex justify-content-between align-items-center ps-2 py-1">
            <div class="text-truncate">
              <%= link_to (current_user == post.user ? profile_path : user_path(post.user)), data: { turbo: false }, class: 'nav-link d-flex align-items-center flex-grow-1 text-dark' do %>
              
                <%= image_tag post.user.avatar.url, class: 'rounded-circle flex-shrink-0', size: '30x30' %>
                <div class="ms-2 text-truncate d-none d-lg-inline" style="max-width: 140px;">
                  <%= post.user.nickname %>
                </div>
              <% end %>
            </div>
            
            <div class="d-flex align-items-center">
              <div class="d-none d-md-block">
                <%= l post.created_at, format: :date %>
              </div>
              <% if logged_in? %>
                <div>  
                  <% if current_user&.own?(post) %>
                    <%= link_to t('helpers.submit.edit'), edit_spot_post_path(post.spot, post), data: { turbo: false }, class: "btn btn-sm btn-primary", style: "font-size: 12px;"%>
                    <%= link_to t('helpers.submit.delete'), spot_post_path(post.spot, post), data: { turbo: false }, data: { turbo_confirm: t('posts.delete_confirm'), turbo_method: :delete }, class: "btn btn-sm btn-danger", style: "font-size: 12px;"%>
                  <% end %>
                  <button class="btn btn-sm rounded-pill btn-light" data-bs-toggle="modal" data-bs-target="#addToListModal-<%= post.id %>">
                    <i class="bi bi-bookmark-heart" style="font-size: 18px;"></i>
                  </button> 
                </div>
              <% end %>
            </div>
          </div>

          <%= render "posts/bookmark_modal", post: post %>

          <div style="font-size: 14px;">
            <i class="bi bi-pin-angle-fill ms-2"></i> 
            <%= post.spot.prefecture.name %> 
            <%= post.spot.municipality.name %>
          </div>
          <div class="text-truncate p-2" >
            <%= post.content %>
          </div>
          
          <div class="d-grid gap-2 col-9 mx-auto my-2 mt-auto">
            <%= link_to t('posts.index.link_to_detail'), spot_post_path(post.spot, post), data: { turbo: false }, class:"btn btn-outline-success p-2" %>
          </div>
        </div>
      </div>
    
  <% end %>
