<header class="sticky-top" style="background-color: #46aa82">
  <div class="d-flex align-items-center p-1">

    <div class="me-auto">
      <%= link_to "LocalTripHub", root_path, data: { turbo: false }, class: "navbar-brand", style: "font-family: 'Kanit' ", class: "fs-4 text-black text-decoration-none" %>
    </div>

    

    
        <div class="nav-item border-start text-center">
          <%= link_to "/#posted_area_map", data: { turbo: false }, class:"nav-link" do %>
            <div><i class="bi bi-map align-self-center mx-1"></i></div>
            <div class="mx-3" style="font-size: 14px;"><%= t('header.post_map') %></div>
          <% end %>
        </div>
        <div class="dnav-item border-start text-center">
          <%= link_to login_path, data: { turbo: false }, class:"nav-link" do %>
            <div><i class="bi bi-box-arrow-in-right align-self-center mx-1"></i></div>
            <div class="mx-3" style="font-size: 14px;"><%= t('header.login') %></div>
          <% end %>
        </div>
      
  </div>
</header>