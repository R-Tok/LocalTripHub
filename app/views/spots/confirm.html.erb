<% content_for(:title, t('.title'))%>

<h1><%= t('.title') %></h1>
<br>
<p>
  以下の内容でスポットを登録します。よろしいですか？<br>
  <span class="text-danger fw-bold">この内容は基本的に後から編集できません。</span>
</p>

<%= render "spot_block", link: false %>

<%= form_with model: @spot, data: { turbo: false }, local: true do |f| %>
  <%= f.hidden_field :name %>
  <%= f.hidden_field :latitude %>
  <%= f.hidden_field :longitude %>
  <%= f.hidden_field :prefecture_id %>
  <%= f.hidden_field :municipality_id %>
  <% @spot.category_ids.each do |category_id| %>
    <%= hidden_field_tag "spot[category_ids][]", category_id %>
  <% end %>
  <div class="d-flex justify-content-center">
    <%= f.submit "<< やり直す", name: "back", class: "btn btn-secondary mx-3 my-3" %>
    <%= f.submit "登録する", class: "btn btn-success mx-2 w-50 mx-3 my-3" %>
  </div>
<% end %>