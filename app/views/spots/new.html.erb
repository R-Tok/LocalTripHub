<% content_for(:title, t('.title'))%>

  <h1><%= t('.title') %></h1>
  <br>
  <ul class="mb-3">
    <li><h5 class="text-decoration-underline">①②いずれかの方法でスポットの座標を決定してください。</h5></li>
    <p>① 検索ボックスでスポット名称を検索 &emsp; ② 地図上で該当する位置をクリック</p>

    <p>ピンの位置に応じて、緯度経度・都道府県・市町村を自動取得します。</p>

    <li><h5 class="text-decoration-underline">登録するスポット名称、該当するカテゴリをフォームから選択してください。</h5></li>
  </ul>
  <div class="d-flex align-items-center flex-wrap">
    <input id="address" type="textbox" placeholder=<%= t('.search_spot') %> class="p-1">
    <input type="button" value=<%= t('defaults.search') %> onclick="codeAddress()" class="p-1 me-3">
    <div><%= t('.city_judge') %> : <span id="display"></span></div>
  </div>

  <%= render "spotcreate_map" %>
  <%= render partial: "spot_form" %>


<script>
  const prefectureMap = {
    <% @prefectures&.each do |prefecture| %>
      "<%= prefecture.name %>": <%= prefecture.id %>,
    <% end %>
  };

  const municipalityMap = {
    <% @municipalities&.each do |municipality| %>
      "<%= municipality.prefecture.name %><%= municipality.name %>": <%= municipality.id %>,
    <% end %>
  };
</script>